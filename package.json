{
  "name": "palliative-rounds",
  "version": "2.0.0",
  "private": true,
  "description": "Palliative care ward-rounds board. Static frontend + Google Apps Script backend.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:css": "node scripts/build.mjs --css-only",
    "preview": "node dev/server.mjs --dist",
    "test": "node --test tests/backend/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:dist": "node -e \"process.env.E2E_DIST=1;require('child_process').execSync('npx playwright test',{stdio:'inherit',env:process.env})\"",
    "lint": "eslint web/js web/sw.js backend/Code.gs dev scripts tests",
    "perf": "node scripts/perf.mjs",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.48.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "lighthouse": "^12.3.0",
    "tailwindcss": "^3.4.17"
  }
}
