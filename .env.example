# Palliative Rounds has no build-time secrets. This file documents every setting.
# NEVER put real values in the repository.

# --- Local development server (npm run dev) ---
PORT=5173                 # dev server port
LATENCY_MS=400            # simulated Apps Script latency
APP_ACCESS_CODE=          # set to test the sign-in screen locally (e.g. APP_ACCESS_CODE=demo-code)

# --- Apps Script backend: set in the editor, Project Settings > Script Properties ---
# APP_ACCESS_CODE=<long random team code>   required for any public deployment
# GEMINI_API_KEY=<key from Google AI Studio> only for the AI features

# --- CI deployment to Cloudflare Pages: GitHub repository secrets ---
# CLOUDFLARE_API_TOKEN=<token with "Cloudflare Pages: Edit">
# CLOUDFLARE_ACCOUNT_ID=<your account id>

# --- Frontend runtime config: web/js/config.js (public, no secrets) ---
# API_URL, HVC_API_URL, PE_API_URL, PORTCATH_API_URL, PORTCATH_API_KEY
